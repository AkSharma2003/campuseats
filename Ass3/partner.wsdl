<?xml version="1.0" encoding="UTF-8"?>

<definitions
    xmlns="http://schemas.xmlsoap.org/wsdl/"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:pay="urn:unipay"
    targetNamespace="urn:unipay"
    name="PaymentsService">


    <!-- 1. TYPES -->
    <types>

        <xsd:schema
            targetNamespace="urn:unipay"
            elementFormDefault="qualified">


            <!-- Credentials for SOAP Header -->
            <xsd:element name="Credentials">

                <xsd:complexType>

                    <xsd:sequence>

                        <xsd:element
                            name="merchantId"
                            type="xsd:string"/>

                        <xsd:element
                            name="apiKey"
                            type="xsd:string"/>

                    </xsd:sequence>

                </xsd:complexType>

            </xsd:element>


            <!-- Charge Request -->
            <xsd:element name="chargeRequest">

                <xsd:complexType>

                    <xsd:sequence>

                        <xsd:element
                            name="cardToken"
                            type="xsd:string"/>

                        <xsd:element
                            name="amount"
                            type="xsd:decimal"/>

                        <xsd:element
                            name="currency"
                            type="xsd:string"/>

                    </xsd:sequence>

                </xsd:complexType>

            </xsd:element>


            <!-- Charge Response -->
            <xsd:element name="chargeResult">

                <xsd:complexType>

                    <xsd:sequence>

                        <xsd:element
                            name="transactionId"
                            type="xsd:string"/>

                        <xsd:element
                            name="status"
                            type="xsd:string"/>

                    </xsd:sequence>

                </xsd:complexType>

            </xsd:element>


            <!-- Payment Fault -->
            <xsd:element name="PaymentFault">

                <xsd:complexType>

                    <xsd:sequence>

                        <xsd:element
                            name="code"
                            type="xsd:string"/>

                        <xsd:element
                            name="message"
                            type="xsd:string"/>

                    </xsd:sequence>

                </xsd:complexType>

            </xsd:element>


        </xsd:schema>

    </types>


    <!-- 2. MESSAGES -->


    <!-- SOAP Header message -->
    <message name="CredentialsMessage">

        <part
            name="credentials"
            element="pay:Credentials"/>

    </message>


    <!-- Request message -->
    <message name="chargeRequest">

        <part
            name="body"
            element="pay:chargeRequest"/>

    </message>


    <!-- Response message -->
    <message name="chargeResponse">

        <part
            name="body"
            element="pay:chargeResult"/>

    </message>


    <!-- Fault message -->
    <message name="chargeFault">

        <part
            name="fault"
            element="pay:PaymentFault"/>

    </message>


    <!-- 3. PORT TYPE -->

    <portType name="Payments">

        <operation name="charge">

            <input
                message="pay:chargeRequest"/>

            <output
                message="pay:chargeResponse"/>

            <fault
                name="PaymentFault"
                message="pay:chargeFault"/>

        </operation>

    </portType>


    <!-- 4. BINDING -->

    <binding
        name="PaymentsSOAP"
        type="pay:Payments">

        <!-- SOAP over HTTP -->
        <soap:binding
            transport="http://schemas.xmlsoap.org/soap/http"
            style="document"/>


        <operation name="charge">

            <soap:operation
                soapAction="urn:unipay:charge"/>


            <!-- Request -->

            <input>

                <!-- Credentials go into SOAP Header -->
                <soap:header
                    message="pay:CredentialsMessage"
                    part="credentials"
                    use="literal"/>

                <!-- Charge data goes into SOAP Body -->
                <soap:body
                    use="literal"/>

            </input>


            <!-- Response -->

            <output>

                <soap:body
                    use="literal"/>

            </output>


            <!-- Fault -->

            <fault name="PaymentFault">

                <soap:fault
                    name="PaymentFault"
                    use="literal"/>

            </fault>


        </operation>

    </binding>


    <!-- 5 & 6. SERVICE / PORT -->

    <service name="PaymentsService">

        <port
            name="PaymentsSOAP"
            binding="pay:PaymentsSOAP">

            <soap:address
                location="https://api.unipay.example/pay"/>

        </port>

    </service>


</definitions>